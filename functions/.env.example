# Local emulator settings. Copy to functions/.env.local (git-ignored). Firebase loads it only in the emulator;
# a deployed function ignores these, so it can never skip App Check or send the key anywhere but the real Hypa API.

# The emulator has no App Check. true = accept calls without an App Check token (sign-in is still required).
HYPA_SKIP_APP_CHECK=false
# Optional:
# HYPA_API_BASE=http://127.0.0.1:9911
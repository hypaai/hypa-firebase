# Local emulator settings. Copy to functions/.env.local (git-ignored). Firebase loads it only in the emulator;
# a deployed function ignores these, so it can never skip App Check or send the key anywhere but the real Hypa API.

# The emulator has no App Check. true = accept calls without an App Check token (sign-in is still required).
HYPA_SKIP_APP_CHECK=false

# Optional: point at a fake Hypa server instead of https://api.hypaintelligence.com
# HYPA_API_BASE=http://127.0.0.1:9911

# The Hypa key is NOT set here. Locally it goes in functions/.secret.local (see secret.local.example);
# in production it lives in Secret Manager: firebase functions:secrets:set HYPA_API_KEY -P hypa-firebase

# Quest App Check deployment settings. Use the Quest Android app registration and approved build signer.
# QUEST_FIREBASE_APP_ID=
# QUEST_ANDROID_PACKAGE_ID=
# QUEST_ANDROID_SIGNING_SHA256=
